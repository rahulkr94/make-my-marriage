# Application origin used for same-origin request validation and email links.
APP_URL=http://localhost:3000

# MongoDB Atlas connection for accounts and server-managed sessions.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=make_my_marriage

# Resend is required to deliver password-reset and wedding-member invitation links.
# Use an address on a verified domain for real recipients. The Resend sandbox
# sender onboarding@resend.dev can deliver only to the Resend account owner.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Make My Marriage <accounts@example.com>
