# Application origin used for same-origin request validation and email links.
APP_URL=http://localhost:3000

# MongoDB Atlas connection for accounts and server-managed sessions.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=make_my_marriage

# Resend is required to deliver password-reset, wedding-member, and guest invitation links.
# Use an address on a verified domain for real recipients. The Resend sandbox
# sender onboarding@resend.dev can deliver only to the Resend account owner.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Make My Marriage <accounts@example.com>

# Maximum number of attendees a guest may confirm for one assigned event.
RSVP_MAX_ATTENDEES=20

# Private document and gallery-photo storage. Create a private Cloudflare R2
# bucket and an API token limited to object read/write for that bucket.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=make-my-marriage-private
